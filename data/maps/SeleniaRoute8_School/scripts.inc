School_ES_IceBoy::
	lock
	faceplayer
	goto_if_set FLAG_ITEM_SCHOOL_NEVERMELTICE, School_ES_ExplainIce
	msgbox School_Text_IceBoy, MSGBOX_DEFAULT
	giveitem ITEM_NEVER_MELT_ICE
	goto_if_eq VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull
	setflag FLAG_ITEM_SCHOOL_NEVERMELTICE
	release
	end
School_ES_ExplainIce::
	msgbox School_Text_ExplainIce, MSGBOX_DEFAULT
	release
	end
School_Text_IceBoy:
	.string "I love Ice types but I'm\n"
	.string "not really good at battling…\p"
	.string "Here, take this.$"
School_Text_ExplainIce:
	.string "Never-Melt Ice is also known\n"
	.string "as Blue Ice or Stalhrim.\p"
	.string "It's a special kind of ice with\n"
